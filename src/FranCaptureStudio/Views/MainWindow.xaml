<v:StudioWindow x:Class="FranCaptureStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FranCaptureStudio.Views"
        xmlns:l="clr-namespace:FranCaptureStudio"
        Title="Fran Capture Studio" Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navegación lateral -->
    <Border Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,12,16">
          <Image Source="pack://application:,,,/Assets/icon-512.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Fran Capture" FontFamily="{StaticResource UiDisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="STUDIO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;" Content="{l:T 'Configuración'}" Checked="Nav_Checked"/>
          <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="22,8,0,0" FontSize="11"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE80F;" Content="{l:T 'Inicio'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8F1;" Content="{l:T 'Biblioteca'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavRecorder" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE714;" Content="{l:T 'Grabación'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavOcr" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8D2;" Content="{l:T 'OCR'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE90F;" Content="{l:T 'Herramientas'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavQa" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xEBE8;" Content="{l:T 'Reporte de errores'}" Checked="Nav_Checked"/>
            <Border Style="{StaticResource Separator}" Margin="16,10"/>
            <RadioButton x:Name="NavAutomations" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE945;" Content="{l:T 'Automatizaciones'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE765;" Content="{l:T 'Atajos de teclado'}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavStorage" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8B7;" Content="{l:T 'Almacenamiento'}" Checked="Nav_Checked"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- Cabecera sólida, sin transparencias -->
      <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0,16,0">
        <DockPanel LastChildFill="False">
          <TextBlock x:Name="PageTitle" DockPanel.Dock="Left" Style="{StaticResource PageTitle}"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="RecState" Style="{StaticResource Body}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold"/>
            <Button Style="{StaticResource PrimaryButton}" Click="QuickCapture_Click" ToolTip="{l:T 'Capturar una región de la pantalla'}">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" Margin="0,0,8,0" FontSize="14"/><TextBlock Text="{l:T 'Capturar región'}"/></StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid x:Name="PageHost" Grid.Row="1"/>
    </Grid>
  </Grid>
</v:StudioWindow>
