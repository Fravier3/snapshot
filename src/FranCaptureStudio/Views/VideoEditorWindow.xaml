<v:StudioWindow x:Class="FranCaptureStudio.Views.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FranCaptureStudio.Views"
        xmlns:l="clr-namespace:FranCaptureStudio"
        Title="Fran Capture Studio – Editor de video" Width="1060" Height="720" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="FileText" DockPanel.Dock="Left" Style="{StaticResource Body}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380" TextWrapping="NoWrap"/>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Usar fotograma como portada'}" Click="Cover_Click" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Formato'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="FormatBox" Width="90" SelectionChanged="Format_Changed" Margin="0,0,8,0">
            <ComboBoxItem Content="MP4" IsSelected="True"/>
            <ComboBoxItem Content="WebM"/>
            <ComboBoxItem Content="GIF"/>
          </ComboBox>
          <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Calidad'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="QualityBox" Width="100" Margin="0,0,8,0">
            <ComboBoxItem Content="{l:T 'Alta'}" Tag="high" IsSelected="True"/>
            <ComboBoxItem Content="{l:T 'Media'}" Tag="medium"/>
            <ComboBoxItem Content="{l:T 'Baja'}" Tag="low"/>
          </ComboBox>
          <ComboBox x:Name="ResolutionBox" Width="110" Margin="0,0,8,0">
            <ComboBoxItem Content="{l:T 'Original'}" Tag="0" IsSelected="True"/>
            <ComboBoxItem Content="1080p" Tag="1080"/>
            <ComboBoxItem Content="720p" Tag="720"/>
            <ComboBoxItem Content="480p" Tag="480"/>
          </ComboBox>
          <Button x:Name="ExportBtn" Style="{StaticResource PrimaryButton}" Content="{l:T 'Exportar…'}" Click="Export_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Background="{DynamicResource CanvasBrush}">
      <Viewbox Stretch="Uniform" Margin="12">
        <Grid x:Name="Stage" Width="1280" Height="720" Background="Black">
          <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Fill"
                        MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed" MediaEnded="Player_MediaEnded"/>
          <v:VideoOverlayLayer x:Name="OverlayLayer"/>
        </Grid>
      </Viewbox>
      <TextBlock x:Name="PreviewNote" Style="{StaticResource Body}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="520" TextAlignment="Center"/>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="12,8,12,4">
      <DockPanel LastChildFill="False">
        <Button x:Name="PlayBtn" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE768;" Click="Play_Click" ToolTip="{l:T 'Reproducir / pausar (Espacio)'}"/>
        <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="10,0,16,0" FontFamily="Consolas" Text="00:00.0 / 00:00.0"/>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" Text="{l:T 'Velocidad'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="SpeedBox" DockPanel.Dock="Left" Width="86" SelectionChanged="Speed_Changed">
          <ComboBoxItem Content="0.5×" Tag="0.5"/>
          <ComboBoxItem Content="0.75×" Tag="0.75"/>
          <ComboBoxItem Content="1×" Tag="1" IsSelected="True"/>
          <ComboBoxItem Content="1.25×" Tag="1.25"/>
          <ComboBoxItem Content="1.5×" Tag="1.5"/>
          <ComboBoxItem Content="2×" Tag="2"/>
          <ComboBoxItem Content="4×" Tag="4"/>
        </ComboBox>
        <CheckBox x:Name="MuteCheck" DockPanel.Dock="Left" Content="{l:T 'Eliminar audio'}" VerticalAlignment="Center" Margin="18,0,0,0" Click="Mute_Click"/>
        <TextBlock x:Name="ResultText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="12,2,12,6">
      <v:TimelineControl x:Name="Timeline" Height="64"/>
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,4,12,10">
      <WrapPanel>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Inicio aquí (I)'}" Click="TrimStart_Click" Margin="0,0,6,6" ToolTip="{l:T 'Recorta todo lo anterior a la posición actual'}"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Final aquí (O)'}" Click="TrimEnd_Click" Margin="0,0,6,6" ToolTip="{l:T 'Recorta todo lo posterior a la posición actual'}"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Dividir (S)'}" Click="Split_Click" Margin="0,0,6,6"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Eliminar / restaurar segmento (Supr)'}" Click="ToggleSegment_Click" Margin="0,0,6,6"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Deshacer (Ctrl+Z)'}" Click="UndoEdit_Click" Margin="0,0,6,6"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Restablecer'}" Click="Reset_Click" Margin="0,0,18,6"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T '+ Texto'}" Click="AddText_Click" Margin="0,0,6,6"/>
        <Button x:Name="ArrowBtn" Style="{StaticResource SecondaryButton}" Content="{l:T '+ Flecha'}" Click="AddArrow_Click" Margin="0,0,6,6" ToolTip="{l:T 'Arrastra sobre el video para dibujar la flecha'}"/>
        <ComboBox x:Name="OverlayBox" Width="230" Margin="0,0,6,6" SelectionChanged="OverlayBox_Changed"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Desde aquí'}" Click="OverlayStart_Click" Margin="0,0,6,6"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Hasta aquí'}" Click="OverlayEnd_Click" Margin="0,0,6,6"/>
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Quitar'}" Click="OverlayRemove_Click" Margin="0,0,18,6"/>
        <StackPanel x:Name="GifPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
          <TextBlock Style="{StaticResource Muted}" Text="GIF · FPS" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Slider x:Name="GifFpsSlider" Minimum="4" Maximum="30" Value="12" Width="90" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="GifOpt_Changed"/>
          <TextBlock x:Name="GifFpsText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,12,0" Text="12"/>
          <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Ancho máx.'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="GifWidthBox" Width="86">
            <ComboBoxItem Content="320" Tag="320"/>
            <ComboBoxItem Content="480" Tag="480"/>
            <ComboBoxItem Content="640" Tag="640"/>
            <ComboBoxItem Content="800" Tag="800" IsSelected="True"/>
            <ComboBoxItem Content="1280" Tag="1280"/>
          </ComboBox>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border Grid.Row="5" Background="{DynamicResource HeaderBrush}" Padding="12,6">
      <DockPanel>
        <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{l:T 'Cancelar'}" Click="CancelExport_Click" Visibility="Collapsed" Margin="10,0,0,0" MinHeight="26" Padding="10,3"/>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </DockPanel>
    </Border>
  </Grid>
</v:StudioWindow>
