<v:StudioWindow x:Class="FranCaptureStudio.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FranCaptureStudio.Views"
        xmlns:l="clr-namespace:FranCaptureStudio"
        xmlns:e="clr-namespace:FranCaptureStudio.Editor"
        Title="Fran Capture Studio – Editor" Width="1180" Height="780" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Cabecera sólida -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="FileMenuBtn" Style="{StaticResource SecondaryButton}" Content="{l:T 'Archivo ▾'}" Click="OpenMenu" Margin="0,0,6,0"/>
          <Button x:Name="ImageMenuBtn" Style="{StaticResource SecondaryButton}" Content="{l:T 'Imagen ▾'}" Click="OpenMenu" Margin="0,0,6,0"/>
          <Button x:Name="PrivacyMenuBtn" Style="{StaticResource SecondaryButton}" Content="{l:T 'Privacidad ▾'}" Click="OpenMenu" Margin="0,0,6,0"/>
          <Button x:Name="SendMenuBtn" Style="{StaticResource SecondaryButton}" Content="{l:T 'Enviar a ▾'}" Click="OpenMenu" Margin="0,0,12,0"/>
          <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="{l:T 'Deshacer (Ctrl+Z)'}" Click="Undo_Click"/>
          <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="{l:T 'Rehacer (Ctrl+Y)'}" Click="Redo_Click"/>
          <StackPanel x:Name="CropPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
            <TextBlock x:Name="CropInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'Aplicar recorte'}" Click="ApplyCrop_Click" Margin="0,0,6,0"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Cancelar'}" Click="CancelCrop_Click"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Style="{StaticResource SecondaryButton}" Click="Copy_Click" Margin="0,0,6,0" ToolTip="Ctrl+C">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,7,0" FontSize="14"/><TextBlock Text="{l:T 'Copiar'}"/></StackPanel>
          </Button>
          <Button Style="{StaticResource SecondaryButton}" Click="SaveAs_Click" Margin="0,0,6,0" ToolTip="Ctrl+Shift+S">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE792;" Margin="0,0,7,0" FontSize="14"/><TextBlock Text="{l:T 'Guardar como…'}"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Ctrl+S">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,7,0" FontSize="14"/><TextBlock Text="{l:T 'Guardar'}"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Propiedades de la herramienta / selección -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
      <WrapPanel VerticalAlignment="Center">
        <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Button Style="{StaticResource IconButton}" Content="&#xE790;" ToolTip="{l:T 'Otro color…'}" Click="CustomColor_Click" Margin="0,0,14,0"/>
        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Grosor'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="30" Value="4" Width="110" VerticalAlignment="Center" ValueChanged="Thickness_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
        <TextBlock x:Name="ThicknessText" Style="{StaticResource Muted}" Width="22" VerticalAlignment="Center" Margin="6,0,14,0" Text="4"/>
        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Texto'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Slider x:Name="FontSlider" Minimum="10" Maximum="96" Value="22" Width="110" VerticalAlignment="Center" ValueChanged="Font_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
        <TextBlock x:Name="FontText" Style="{StaticResource Muted}" Width="22" VerticalAlignment="Center" Margin="6,0,14,0" Text="22"/>
        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Intensidad'}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{l:T 'Pixelado y desenfoque'}"/>
        <Slider x:Name="StrengthSlider" Minimum="4" Maximum="40" Value="12" Width="90" VerticalAlignment="Center" ValueChanged="Strength_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
        <CheckBox x:Name="FillCheck" Content="{l:T 'Relleno'}" VerticalAlignment="Center" Margin="14,0,14,0" Click="Fill_Click"/>
        <Button x:Name="DuplicateBtn" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{l:T 'Duplicar elemento (Ctrl+D)'}" Click="Duplicate_Click"/>
        <Button x:Name="FrontBtn" Style="{StaticResource IconButton}" Content="&#xE81E;" ToolTip="{l:T 'Traer al frente'}" Click="Front_Click"/>
        <Button x:Name="DeleteBtn" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T 'Eliminar elemento (Supr)'}" Click="Delete_Click"/>
      </WrapPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ToolRail"/>
        </ScrollViewer>
      </Border>
      <ScrollViewer x:Name="Scroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource CanvasBrush}" PreviewMouseWheel="Scroll_PreviewMouseWheel" Focusable="False">
        <Grid x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
            <e:EditorCanvas x:Name="Canvas"/>
          </Border>
          <Canvas x:Name="Overlay"/>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="{l:T 'Alejar'}" Click="ZoomOut_Click"/>
          <TextBlock x:Name="ZoomText" Style="{StaticResource Muted}" Width="48" TextAlignment="Center" VerticalAlignment="Center" Text="100 %"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="{l:T 'Acercar'}" Click="ZoomIn_Click"/>
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Ajustar'}" Click="ZoomFit_Click" Margin="6,0,0,0" Padding="10,3" MinHeight="26"/>
          <Button Style="{StaticResource SecondaryButton}" Content="100 %" Click="Zoom100_Click" Margin="6,0,0,0" Padding="10,3" MinHeight="26"/>
        </StackPanel>
        <TextBlock x:Name="SizeText" DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <TextBlock x:Name="PosText" DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="130"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </DockPanel>
    </Border>
  </Grid>
</v:StudioWindow>
