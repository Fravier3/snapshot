<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FranCaptureStudio</AssemblyName>
    <RootNamespace>FranCaptureStudio</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
    <AssemblyTitle>Fran Capture Studio</AssemblyTitle>
    <Description>Capturas, grabaciones y productividad para Windows 11</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FranCapture.Core\FranCapture.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\icon-512.png" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="FranCaptureStudio.WinTests" />
    <!-- FFmpeg (compilación LGPL) descargado por build/fetch-ffmpeg.ps1; se distribuye como ejecutable independiente -->
    <Content Include="..\..\third_party\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" Condition="Exists('..\..\third_party\ffmpeg\ffmpeg.exe')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\ffmpeg\VERSION.txt" Link="ffmpeg\VERSION.txt" Condition="Exists('..\..\third_party\ffmpeg\VERSION.txt')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\ffmpeg\LICENSE.txt" Link="ffmpeg\LICENSE.txt" Condition="Exists('..\..\third_party\ffmpeg\LICENSE.txt')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" Condition="Exists('..\..\LICENSE.txt')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
