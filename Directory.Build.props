<Project>
  <PropertyGroup>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Company>Desarrollos Francisco J Vazquez Santiago</Company>
    <Authors>Desarrollos Francisco J Vazquez Santiago</Authors>
    <Product>Fran Capture Studio</Product>
    <Copyright>© 2026 Desarrollos Francisco J Vazquez Santiago</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
